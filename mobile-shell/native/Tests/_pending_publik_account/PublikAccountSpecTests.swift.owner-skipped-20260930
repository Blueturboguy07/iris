        }
    }

    func testStorefrontChangeInvalidatesAnOtherwiseValidOffer() {
        XCTAssertEqual(decision(context()), .externalBrowser(packURL), "SPEC.md:57 PA-032: initially eligible USA")
        XCTAssertEqual(decision(context(storefront: "GBR")), .hidden(reason: .restrictedStorefront), "SPEC.md:57 PA-032: recheck hides after change")
