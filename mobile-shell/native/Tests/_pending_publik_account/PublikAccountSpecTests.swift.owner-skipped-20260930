    func testBackDuringAuthenticationDropsLateSuccess() async throws {
        let started = expectation(description: "SPEC.md:31 PA-021: system authentication began")
        let service = try AccountWorld(account: snapshot(), held: .signIn, started: { started.fulfill() })
        let store = PublikAPIAccountStore(service: service)
        let operation = Task { await store.signIn() }
        await fulfillment(of: [started], timeout: 3)
        let busy = await store.state()
        XCTAssertTrue(busy.isBusy, "SPEC.md:155 PA-061: busy published before await")
        XCTAssertEqual(busy.session, .authenticating, "SPEC.md:31 PA-021: authentication in progress")
