// Fake only external account/auth/network boundaries. Policy and state are real product types.
private actor AccountWorld: PublikAPIAccountService {
    enum Held: Equatable, Sendable { case signIn, refresh, week }
    private var account: PublikAPIAccountSnapshot
    private var restoreFailure: PublikAPIAccountFailure?
    private let restoreHasSession: Bool
    private var signInFailure: PublikAPIAccountFailure?
    private var refreshFailure: PublikAPIAccountFailure?
    private var signOutFailure: PublikAPIAccountFailure?
    private var deletion: PublikAPIDeletionResult = .unavailable
    private var usageFailure: PublikAPIAccountFailure?
    private var pages: [PublikAPIUsagePage]
    private var transactionPages: [PublikAPITransactionPage]
    private let held: Held?
    private let started: @Sendable () -> Void
    private var continuation: CheckedContinuation<Void, Never>?
    private var released = false

    init(account: PublikAPIAccountSnapshot, restoreHasSession: Bool = true, restoreFailure: PublikAPIAccountFailure? = nil,
         signInFailure: PublikAPIAccountFailure? = nil, refreshFailure: PublikAPIAccountFailure? = nil,
         signOutFailure: PublikAPIAccountFailure? = nil, pages: [PublikAPIUsagePage] = [],
         transactionPages: [PublikAPITransactionPage] = [],
         held: Held? = nil, started: @escaping @Sendable () -> Void = {}) {
        self.restoreHasSession = restoreHasSession
        self.account = account; self.restoreFailure = restoreFailure; self.signInFailure = signInFailure
        self.refreshFailure = refreshFailure; self.signOutFailure = signOutFailure; self.pages = pages
        self.transactionPages = transactionPages
        self.held = held; self.started = started
    }
    private func suspend(_ operation: Held) async {
        guard held == operation, !released else { return }
        await withCheckedContinuation { continuation in
            self.continuation = continuation
            started()
        }
    }
    func release() { released = true; continuation?.resume(); continuation = nil }
    func replaceAccount(_ account: PublikAPIAccountSnapshot) { self.account = account }
    func setRefreshFailure(_ failure: PublikAPIAccountFailure?) { refreshFailure = failure }
    func setRestoreFailure(_ failure: PublikAPIAccountFailure?) { restoreFailure = failure }
    func setUsageFailure(_ failure: PublikAPIAccountFailure?) { usageFailure = failure }
    func acceptDeletion() { deletion = .accepted }
    func restoreSession() async throws -> PublikAPIAccountSnapshot? {
        if let restoreFailure { throw restoreFailure }
        return restoreHasSession ? account : nil
    }
    func signIn() async throws -> PublikAPIAccountSnapshot {
        let result = account
        await suspend(.signIn)
        if let signInFailure { throw signInFailure }
        return result
    }
    func refreshAccount() async throws -> PublikAPIAccountSnapshot {
        let result = account
        await suspend(.refresh)
        if let refreshFailure { throw refreshFailure }
        return result
    }
    func fetchUsage(period: PublikAPIUsagePeriod, cursor: String?) async throws -> PublikAPIUsagePage {
        let id = account.identity.accountID
        if period == .week { await suspend(.week) }
        if let usageFailure { throw usageFailure }
        if !pages.isEmpty {
            let page = cursor == nil ? 0 : (Int(cursor!.replacingOccurrences(of: "page-", with: "")) ?? 1)
            return pages[min(page, pages.count - 1)]
        }
        return PublikAPIUsagePage(accountID: id, period: period, total: nil,
            records: [PublikAPIUsageRecord(id: period == .week ? "week" : "thirty", occurredAt: account.observedAt,
                appName: nil, modelName: nil, status: "Completed", cost: nil)], nextCursor: nil, available: true)
    }
    func fetchTransactions(cursor: String?) async throws -> PublikAPITransactionPage {
        if !transactionPages.isEmpty { return transactionPages[min(cursor == nil ? 0 : 1, transactionPages.count - 1)] }
        return PublikAPITransactionPage(accountID: account.identity.accountID, records: [], nextCursor: nil, available: true)
    }
    func signOut() async throws { if let signOutFailure { throw signOutFailure } }
    func requestDeletion() async throws -> PublikAPIDeletionResult { deletion }
}

// Only the external clock is mutable. Advancing time never waits or polls.
private final class SpecClock: @unchecked Sendable {
    private let lock = NSLock()
    private var instant: Date
    init(_ instant: Date) { self.instant = instant }
    func read() -> Date { lock.lock(); defer { lock.unlock() }; return instant }
    func advance(_ seconds: TimeInterval) { lock.lock(); defer { lock.unlock() }; instant.addTimeInterval(seconds) }
}
