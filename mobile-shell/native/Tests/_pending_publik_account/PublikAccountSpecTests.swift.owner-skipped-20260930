    func testVerifiedRetryIntervalPreventsEarlyRefreshAndAllowsRecovery() async throws {
        let clock = SpecClock(now)
        let service = try AccountWorld(account: snapshot(), refreshFailure: .rateLimited(retryAfterSeconds: 60))
        let store = PublikAPIAccountStore(service: service, now: { clock.read() })
        await store.signIn()
        await store.refresh()
        await service.setRefreshFailure(nil)
        await service.replaceAccount(try snapshot(amount: 7_000_000))
        clock.advance(59)
        await store.refresh()
        let early = await store.state()
        XCTAssertEqual(early.account?.balance?.available.microUSD, 12_340_000, "SPEC.md:94 PA-042: Refresh cannot send before verified interval")
        XCTAssertEqual(early.failure, .rateLimited(retryAfterSeconds: 60), "SPEC.md:94 PA-042: early retry retains safe rate-limit category")
        clock.advance(1)
        await store.refresh()
        let recovered = await store.state()
        XCTAssertEqual(recovered.account?.balance?.available.microUSD, 7_000_000, "SPEC.md:94 PA-042: permitted retry at interval boundary loads fresh credit")
        XCTAssertNil(recovered.failure, "SPEC.md:94 PA-042: successful retry clears rate limit")
    }

