        XCTAssertEqual(cancelled.session, .signedOut, "SPEC.md:31 PA-021: late callback cannot sign in")
        XCTAssertNil(cancelled.account, "SPEC.md:31 PA-021: late identity discarded")
    }

    func testFlakyNetworkPreservesValidatedFactsButExpiryClearsEverything() async throws {
        let service = try AccountWorld(account: snapshot())
        let store = PublikAPIAccountStore(service: service)
        await store.signIn()
        await service.setRefreshFailure(.offline)
        await store.refresh()
        let offline = await store.state()
        XCTAssertEqual(offline.account, try snapshot(), "SPEC.md:33 PA-022 and SPEC.md:92 PA-041: safe stale snapshot retained")
        XCTAssertEqual(offline.session, .signedIn(accountID: "person-a"), "SPEC.md:33 PA-022: transient failure is not expiry")
        XCTAssertEqual(offline.failure, .offline, "SPEC.md:92 PA-041: offline state exposed")
        await service.setRefreshFailure(nil)
        await store.refresh()
        let observed2 = await store.state()
        XCTAssertNil(observed2.failure, "SPEC.md:92 PA-041: explicit retry recovers")
        await store.selectUsagePeriod(.week)
        await store.loadTransactions()
        await service.setRefreshFailure(.sessionExpired)
        await store.refresh()
        let expired = await store.state()
        XCTAssertEqual(expired.session, .expired, "SPEC.md:35 PA-023: rejected session expires")
        XCTAssertNil(expired.account, "SPEC.md:35 PA-023: clear identity and balance")
        XCTAssertNil(expired.usage, "SPEC.md:35 PA-023: clear usage")
        XCTAssertNil(expired.transactions, "SPEC.md:35 PA-023: clear transactions")
    }

