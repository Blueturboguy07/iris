    func testSignOutAndAccountSwitchRejectLateAccountARefresh() async throws {
        let started = expectation(description: "SPEC.md:96 PA-043: A refresh is suspended at network edge")
        let service = try AccountWorld(account: snapshot(), held: .refresh, started: { started.fulfill() })
        let store = PublikAPIAccountStore(service: service)
