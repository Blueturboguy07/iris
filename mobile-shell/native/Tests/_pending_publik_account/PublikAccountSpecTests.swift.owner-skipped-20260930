    private func snapshot(id: String = "person-a", amount: Int64 = 12_340_000) throws -> PublikAPIAccountSnapshot {
        PublikAPIAccountSnapshot(identity: PublikAPIIdentity(accountID: id, displayName: "Synthetic Person", email: "person@example.invalid"),
            balance: PublikAPIBalance(available: try PublikAPIAmount(microUSD: amount), plan: nil, pack: nil,
                free: nil, existingPlan: nil, resetAt: nil, used: nil, budget: nil), observedAt: now)
    }

    private func record(_ id: String, seconds: TimeInterval, cost: Int64 = 1_000) throws -> PublikAPIUsageRecord {
        PublikAPIUsageRecord(id: id, occurredAt: now.addingTimeInterval(seconds), appName: nil,
                            modelName: nil, status: "Completed", cost: try PublikAPIAmount(microUSD: cost))
    }

    func testFirstTimePersonStartsWithoutInventedAccountFacts() async throws {
        let service = try AccountWorld(account: snapshot(), restoreHasSession: false)
        let store = PublikAPIAccountStore(service: service)
        let initial = await store.state()
        XCTAssertEqual(initial.session, .signedOut, "SPEC.md:155 PA-061: no implicit sign-in")
        XCTAssertNil(initial.account, "SPEC.md:155 PA-061: no invented identity or balance")
        XCTAssertNil(initial.usage, "SPEC.md:155 PA-061: no invented history")
        XCTAssertNil(initial.transactions, "SPEC.md:155 PA-061: no invented transactions")
        XCTAssertEqual(initial.selectedPeriod, .week, "SPEC.md:155 PA-061: initial week")
        XCTAssertFalse(initial.isBusy, "SPEC.md:155 PA-061: initially idle")
        XCTAssertNil(initial.failure, "SPEC.md:155 PA-061: initially no failure")
        XCTAssertFalse(initial.deletionRequested, "SPEC.md:155 PA-061: no invented deletion acknowledgement")
        await store.restoreSession()
        let observed1 = await store.state()
        XCTAssertEqual(observed1.session, .signedOut, "SPEC.md:33 PA-022: no saved token")
        await store.signIn()
        let signedIn = await store.state()
        XCTAssertEqual(signedIn.session, .signedIn(accountID: "person-a"), "SPEC.md:31 PA-021: successful sign-in")
        XCTAssertEqual(signedIn.account, try snapshot(), "SPEC.md:33 PA-022: supplied facts only")
    }

