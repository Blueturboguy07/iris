        let service = try AccountWorld(account: snapshot(), pages: [first, second])
        let store = PublikAPIAccountStore(service: service)
        await store.signIn()
        await store.selectUsagePeriod(.week)
        await service.setUsageFailure(.offline)
        await store.loadMoreUsage()
        let failed = await store.state()
        XCTAssertEqual(failed.usage?.records.map(\.id), ["first"], "SPEC.md:96 PA-043: failed page retains prior rows")
        XCTAssertEqual(failed.usage?.nextCursor, "next", "SPEC.md:96 PA-043: failed page retains retry cursor")
        await service.setUsageFailure(nil)
        await store.loadMoreUsage()
        let retried = await store.state()
        XCTAssertEqual(retried.usage?.records.map(\.id), ["first", "second"], "SPEC.md:96 PA-043: retry appends correct page")
        XCTAssertNil(retried.usage?.nextCursor, "SPEC.md:47 PA-028: successful final page exhausts cursor")
    }

    func testUsageRetentionStopsAtOneThousandWithoutSummingTheTotal() async throws {
        let total = try PublikAPIAmount(microUSD: 9_999_999)
        var pages: [PublikAPIUsagePage] = []
        for page in 0..<21 {
            let rows = try (0..<50).map { offset in
                try record(String(format: "r%04d", page * 50 + offset), seconds: -Double(page * 50 + offset))
            }
            pages.append(PublikAPIUsagePage(accountID: "person-a", period: .week, total: total,
                records: rows, nextCursor: "page-\(page + 1)", available: true))
        }
        let service = try AccountWorld(account: snapshot(), pages: pages)
        let store = PublikAPIAccountStore(service: service)
        await store.signIn()
        await store.selectUsagePeriod(.week)
        for _ in 0..<21 { await store.loadMoreUsage() }
        let state = await store.state()
        XCTAssertEqual(state.usage?.records.count, 1_000, "SPEC.md:47 PA-028: bounded retained usage")
        XCTAssertEqual(state.usage?.records.first?.id, "r0000", "SPEC.md:47 PA-028: retain latest request")
        XCTAssertEqual(state.usage?.records.last?.id, "r0999", "SPEC.md:47 PA-028: retain latest thousand")
        XCTAssertEqual(state.usage?.total, total, "SPEC.md:47 PA-028: authoritative total survives local limit")
    }

