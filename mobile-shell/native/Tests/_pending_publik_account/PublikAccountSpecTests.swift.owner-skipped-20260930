        await refresh.value
        let switched = await store.state()
        XCTAssertEqual(switched.session, .signedIn(accountID: "person-b"), "SPEC.md:37 PA-024: old response cannot restore A")
        XCTAssertEqual(switched.account?.balance?.available.microUSD, 7_000_000, "SPEC.md:37 PA-024: B credit survives A late response")
        XCTAssertEqual(switched.account?.identity.accountID, "person-b", "SPEC.md:37 PA-024: B identity survives")
    }

