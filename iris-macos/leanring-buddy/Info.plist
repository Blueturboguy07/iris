	<true/>
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/julianjear/makesomething-mac-app/main/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>/l3d2rw5ZZFRU3AadP/w2Zf8FHfhA6bKv16BQOV5OSk=</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Iris needs screen recording access to see your screen and help you.</string>
	<!-- Claims the iris:// scheme so the OAuth redirect and the website's guide
	     handoff links reach this app. Every accepted shape is defined in
	     DeepLinkParser.swift; anything else is refused there. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.publikhq.iris.deeplink</string>
			<key>CFBundleTypeRole</key>
