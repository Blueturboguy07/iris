    func testPagingDeduplicatesFirstOccurrenceOrdersRowsAndKeepsServerTotal() async throws {
        let original = try record("same", seconds: -60, cost: 7_000)
        let duplicate = try record("same", seconds: -30, cost: 99_000)
        let first = try usage([original], cursor: "next")
        let second = try usage([duplicate, record("z", seconds: -10), record("a", seconds: -10)], cursor: nil)
        let service = try AccountWorld(account: snapshot(), pages: [first, second])
        let store = PublikAPIAccountStore(service: service)
        await store.signIn()
        await store.selectUsagePeriod(.week)
        await store.loadMoreUsage()
        let state = await store.state()
        XCTAssertEqual(state.usage?.records.map(\.id), ["a", "z", "same"], "SPEC.md:155 PA-061: newest first with lexical tie-break, deduplicated")
        XCTAssertEqual(state.usage?.records.last, original, "SPEC.md:155 PA-061: retain first occurrence")
        XCTAssertEqual(state.usage?.total?.microUSD, 123_456, "SPEC.md:47 PA-028: server total is not sum of visible rows")
        XCTAssertNil(state.usage?.nextCursor, "SPEC.md:47 PA-028: exhausted server cursor")
    }

    func testFailedNextPageKeepsRowsAndCursorSoThePersonCanRetry() async throws {
        let first = try usage([record("first", seconds: -10)], cursor: "next")
