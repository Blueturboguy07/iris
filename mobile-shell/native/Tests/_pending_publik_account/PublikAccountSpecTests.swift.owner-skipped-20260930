        let out = await store.state()
        XCTAssertEqual(out.session, .signedOut, "SPEC.md:37 PA-024: local sign-out succeeds")
        XCTAssertNil(out.account, "SPEC.md:37 PA-024: account memory cleared")
        XCTAssertNil(out.usage, "SPEC.md:37 PA-024: usage cleared")
        XCTAssertNil(out.transactions, "SPEC.md:37 PA-024: transactions cleared")
        await service.replaceAccount(try snapshot(id: "person-b", amount: 7_000_000))
