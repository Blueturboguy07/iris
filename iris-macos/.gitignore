worker/node_modules/
worker/.dev.vars
.DS_Store
*.xcuserstate
build/
releases/
.claude/
coding-plans/

# Xcode derived data for the agent-run build/test loop. 646 MB the last time
# someone measured it, and it shows as untracked, so it is one `git add -A`
# away from the history of a public repo.
.build-check/
.build-report/
.build-*/
.build-release/
.build-progress/
.build-adv/
.build-gate/
.build-repair/

# The edit battery's fixtures are committed as FILES; their git repos are built
# on first use by `battery.py`'s ensure_fixture_repo. A .git nested inside this
# repo cannot be tracked — git records a gitlink to a submodule that does not
# exist and the fixture's own files vanish from the commit.
tools/edit-battery/fixtures/*/work/.git/

# Leftover minting material for t6's oracle tokens — a real Ed25519 private key
# that NOTHING in the battery reads (the tokens are committed already signed).
# iris is a public repo; this never goes near it.
tools/edit-battery/fixtures/*/oracle/secret/*.pem

# The publik app token this Mac bakes into a LOCAL release build
# (`pat_iris_<32>`, read by scripts/release-app-token.sh into the xcodebuild
# PUBLIK_APP_TOKEN setting). CI gets its own copy from the PUBLIK_APP_TOKEN
# repo secret; this file exists because macOS releases are cut locally, where
# that secret is unreachable.
#
# The token is public by construction — it ships inside every binary and the
# gateway is built for that (per-release, revocable by timestamp, IP rate
# limited, small starter). But "readable by anyone who unpacks a dmg" and
# "in a public git history forever, for every release at once" are different
# risks. iris is a public repo. This never goes near it.
.publik-app-token
