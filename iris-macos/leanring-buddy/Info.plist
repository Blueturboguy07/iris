<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSUIElement</key>
	<true/>
	<!-- Iris's own appcast, generated on publikhq.com from the public
	     Blueturboguy07/iris release list (see app/api/iris/appcast/route.ts in
	     the publik repo) rather than a static file, so it is never stale. The
	     old makesomething-mac-app feed URL and its EdDSA key are gone for good
	     — see the Sep 20 2026 fix (commit a006639) that removed them. -->
	<key>SUFeedURL</key>
	<string>https://publikhq.com/api/iris/appcast</string>
	<!-- The PUBLIC half of an EdDSA keypair generated on Sep 21 2026
	     specifically for Iris (`generate_keys --account iris`, from the
	     Sparkle 2.10.0 CLI distribution). The private half never touched this
	     file or git history — it lives only in the Blueturboguy07/iris GitHub
	     Actions secret SPARKLE_ED_PRIVATE_KEY, used by iris-release.yml to
	     sign each release's dmg with sign_update. -->
	<key>SUPublicEDKey</key>
	<string>0PPUd8joCrRLsU0SZtSHbN0nryim8VSVcIX4IWC8F10=</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Iris needs screen recording access to see your screen and help you.</string>
	<!-- Claims the iris:// scheme so the OAuth redirect and the website's guide
	     handoff links reach this app. Every accepted shape is defined in
	     DeepLinkParser.swift; anything else is refused there. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.publikhq.iris.deeplink</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>iris</string>
			</array>
		</dict>
	</array>
	<!-- Where the funded assistant tier and the guide API live. Overridable so
	     the publik site can be developed against this app on localhost; the
	     value is checked against GuideService's origin allowlist at runtime, so
	     editing it cannot point signed-in traffic at an arbitrary server. -->
	<key>PublikAPIBaseURL</key>
	<string>https://publikhq.com</string>
	<!-- The build's public app token (`pat_iris_<32>`), the machine route into
	     POST /api/v1/installs. Injected, never committed: Xcode expands the
	     build setting at build time, so a release passes
	     `PUBLIK_APP_TOKEN=pat_iris_…` to xcodebuild (scripts/release-app-token.sh
	     reads it from the gitignored .publik-app-token, CI from the repo secret
	     of the same name).

	     An undefined setting expands to the empty string, and
	     PublikAPIAccount.buildAppToken refuses both that and any value without
	     the `pat_` prefix — so a developer build, or one where the injection was
	     forgotten, falls back to the paste route instead of sending nonsense to
	     the gateway on every launch. That fallback is the supported state for
	     any build without a token, not a degraded one. -->
	<key>PublikAppToken</key>
	<string>$(PUBLIK_APP_TOKEN)</string>
	<key>PublikSupabaseURL</key>
	<string>https://gcbxnxwwuuqsypwevfgi.supabase.co</string>
	<!-- PUBLIC VALUE, NOT A SECRET. This is the Supabase anonymous (publishable)
	     key: publikhq.com already ships this exact string in its JavaScript
	     bundle, where any visitor can read it. It names the project and nothing
	     more — every row it can reach is gated by row-level-security policies on
	     the server. Do not "fix" this by moving it to the Keychain or a proxy.
	     The service-role key, which IS a secret, never comes near this app. -->
	<key>PublikSupabaseAnonKey</key>
	<string>sb_publishable_NMoK8uAeTxAnguysrcEJSQ_bLW4X21K</string>
</dict>
</plist>
