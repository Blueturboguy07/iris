{
  "name": "iris-windows",
  "version": "0.1.0",
  "description": "Iris — publik's desktop companion for Windows. A text-first fork of tekram/clicky-windows.",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run compile && electron-forge start",
    "compile": "tsc -p tsconfig.build.json",
    "build": "npm run compile && electron-forge make",
    "package": "npm run compile && electron-forge package",
    "make": "npm run compile && electron-forge make",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "gui-e2e": "node tests/gui-e2e/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Blueturboguy07/publik.git",
    "directory": "iris-windows"
  },
  "keywords": [
    "ai",
    "screen-companion",
    "claude",
    "electron",
    "windows",
    "publik",
    "iris"
  ],
  "author": "publik",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.6.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "electron": "^33.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {}
}
