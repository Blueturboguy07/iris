// Independent examples and schedules come from SPEC.md, never from product internals.
final class PublikAccountSpecTests: XCTestCase {
    private let now = Date(timeIntervalSince1970: 1_790_769_600) // 2026-09-30 12:00 UTC
    private let packURL = URL(string: "https://publikhq.com/dashboard/api")!

    func testExactMoneyIncludingSmallestCreditAndInt64Boundary() throws {
        let examples: [(Int64, String)] = [
            (0, "$0.00 USD"), (1, "$0.000001 USD"), (4_000, "$0.004 USD"),
            (10_000, "$0.01 USD"), (999_999, "$0.999999 USD"),
            (1_000_001, "$1.000001 USD"), (12_340_000, "$12.34 USD"),
            (Int64.max, "$9223372036854.775807 USD")
        ]
        for (raw, expected) in examples {
            XCTAssertEqual(try PublikAPIAmount(microUSD: raw).formattedUSD, expected,
                           "SPEC.md:43 PA-026: exact available credit must not round up or vanish")
        }
    }

    func testCanonicalMoneyParsingRejectsProtocolGarbage() throws {
        for text in ["", "-1", "+1", "00", "01", "1.0", "1e6", "true", " 1", "1\n", "١", "１２", "9223372036854775808"] {
            XCTAssertThrowsError(try PublikAPIAmount.parseMicroUSD(text), "SPEC.md:130 PA-060: reject noncanonical or overflowing money") { error in
                XCTAssertEqual(error as? PublikAPIAccountFailure, .invalidData, "SPEC.md:130 PA-060: sanitized invalidData")
            }
        }
        XCTAssertThrowsError(try PublikAPIAmount(microUSD: -1), "SPEC.md:43 PA-026: negative balance is invalid") { error in
            XCTAssertEqual(error as? PublikAPIAccountFailure, .invalidData, "SPEC.md:130 PA-060: negative amount failure")
        }
        XCTAssertEqual(try PublikAPIAmount.parseMicroUSD("9223372036854775807").microUSD, Int64.max, "SPEC.md:130 PA-060: valid boundary is retained")
        XCTAssertEqual(try PublikAPIAmount.parseMicroUSD("0").microUSD, 0, "SPEC.md:130 PA-060: canonical zero accepted")
    }

    func testUTCBoundsAcrossMondayAndMonthBoundary() {
        let clock = ISO8601DateFormatter()
        for (current, monday) in [
            ("2026-09-30T12:00:00Z", "2026-09-28T00:00:00Z"),
            ("2026-10-04T23:59:59Z", "2026-09-28T00:00:00Z"),
            ("2026-10-05T00:00:00Z", "2026-10-05T00:00:00Z"),
            ("2027-01-01T00:00:00Z", "2026-12-28T00:00:00Z")
        ] {
            let end = clock.date(from: current)!
            XCTAssertEqual(PublikAPIUsagePeriod.week.bounds(now: end), DateInterval(start: clock.date(from: monday)!, end: end), "SPEC.md:47 PA-028: Monday UTC boundary")
            XCTAssertEqual(PublikAPIUsagePeriod.thirtyDays.bounds(now: end), DateInterval(start: end.addingTimeInterval(-2_592_000), end: end), "SPEC.md:47 PA-028: exactly thirty days through now")
        }
    }

    private func context(storefront: String? = "USA", policy: Bool = true, regional: Bool = true,
                         payment: Bool = true, age: Bool = true, online: Bool = true, fresh: Bool = true,
                         url: URL? = nil, verified: Bool = true, expiry: Date? = nil) -> PublikAPIPurchaseContext {
        PublikAPIPurchaseContext(storefront: storefront, policyCurrent: policy, regionRequirementsMet: regional,
            paymentAuthorityEligible: payment, ageEligible: age, online: online, accountFresh: fresh,
            offer: PublikAPICreditOffer(destination: url ?? packURL, verifiedCreditPack: verified,
                                        validUntil: expiry ?? now.addingTimeInterval(60)))
    }

    private func decision(_ context: PublikAPIPurchaseContext, session: PublikAPISessionState = .signedIn(accountID: "person-a")) -> PublikAPIPurchaseDecision {
        PublikAPIPurchasePolicy.decision(context: context, session: session, now: now)
    }

    func testEveryRestrictedStorefrontAndUnknownFailsClosed() {
        for region in ["DEU", "FRA", "JPN", "BRA", "KOR", "NLD", "NOR", "ISL", "RUS", "GBR", "CAN", "AUS"] {
            XCTAssertEqual(decision(context(storefront: region)), .hidden(reason: .restrictedStorefront), "SPEC.md:59 PA-033 and SPEC.md:157 PA-062: only USA can open")
        }
        for region: String? in [nil, "", "UNKNOWN", "usa", "US", " USA", "USA\n", "12A"] {
            XCTAssertEqual(decision(context(storefront: region)), .hidden(reason: .unknownStorefront), "SPEC.md:157 PA-062: unknown and malformed storefronts fail closed")
        }
        XCTAssertEqual(decision(context()), .externalBrowser(packURL), "SPEC.md:76 PA-034 and SPEC.md:157 PA-062: verified US pack opens browser")
    }

    func testEveryUSPrerequisiteAndDenialPrecedence() {
        let examples: [(PublikAPIPurchaseContext, PublikAPISessionState, PublikAPIPurchaseDenial)] = [
            (context(storefront: nil, policy: false, age: false), .signedOut, .unknownStorefront),
            (context(storefront: "GBR", policy: false, age: false), .signedOut, .restrictedStorefront),
            (context(policy: false, age: false), .signedOut, .policyUnavailable),
            (context(regional: false), .signedOut, .eligibilityUnavailable),
            (context(payment: false), .signedIn(accountID: "person-a"), .eligibilityUnavailable),
            (context(age: false), .signedIn(accountID: "person-a"), .eligibilityUnavailable),
            (context(online: false), .signedOut, .signedOut),
            (context(), .authenticating, .signedOut), (context(), .expired, .signedOut),
            (context(online: false), .signedIn(accountID: "person-a"), .accountUnavailable),
            (context(fresh: false), .signedIn(accountID: "person-a"), .accountUnavailable),
            (context(verified: false), .signedIn(accountID: "person-a"), .unverifiedOffer),
            (context(expiry: now), .signedIn(accountID: "person-a"), .unverifiedOffer),
            (context(expiry: now.addingTimeInterval(-1)), .signedIn(accountID: "person-a"), .unverifiedOffer)
        ]
        for (input, session, reason) in examples {
            XCTAssertEqual(decision(input, session: session), .hidden(reason: reason), "SPEC.md:157 PA-062: denial precedence and every prerequisite")
        }
        let missingOffer = PublikAPIPurchaseContext(storefront: "USA", policyCurrent: true, regionRequirementsMet: true,
            paymentAuthorityEligible: true, ageEligible: true, online: true, accountFresh: true, offer: nil)
        XCTAssertEqual(decision(missingOffer), .hidden(reason: .unverifiedOffer), "SPEC.md:157 PA-062: missing offer evidence")
    }

    func testUnsafeDestinationsNeverEscapeTheApp() {
